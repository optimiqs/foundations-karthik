{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx"
  },
  "include": [
    "weeks",
    "scripts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}
